{
  "manifest_version": 3,
  "name": "Daily Desk — ChatGPT Browser Connection",
  "version": "2.0.2",
  "minimum_chrome_version": "116",
  "description": "Read your three linked ChatGPT chats and send Try again today on request. No OpenAI API key or API generation.",
  "permissions": ["scripting", "alarms", "storage"],
  "host_permissions": ["https://chatgpt.com/*", "http://127.0.0.1/*"],
  "background": {"service_worker":"background.js","type":"module"},
  "action": {"default_title":"Open Daily Desk"},
  "content_scripts": [{
    "matches":["http://127.0.0.1/*","http://localhost/*"],
    "js":["dashboard-bridge.js"],
    "run_at":"document_start"
  }]
}
